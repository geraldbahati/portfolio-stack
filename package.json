{
  "name": "portfolio-stack",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^22.20.1",
      "@cloudflare/workers-types": "^5.20260728.1",
      "hono": "^4.12.32",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.6.27",
      "@orpc/client": "^1.14.12",
      "drizzle-orm": "^0.45.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:deployment": "bun scripts/verify-deployment.ts",
    "check": "bun run lint && bun run check-types && bun run test",
    "db:seed-admin": "bun packages/auth/src/seed-admin-cli.ts",
    "db:seed-projects": "bun packages/db/src/seed-projects-cli.ts",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:generate": "turbo run db:generate -F @portfolio-stack/db --",
    "deploy": "turbo run deploy -F @portfolio-stack/infra --",
    "destroy": "turbo run destroy -F @portfolio-stack/infra --"
  },
  "dependencies": {
    "@portfolio-stack/env": "workspace:*",
    "dotenv": "catalog:",
    "marked": "^18.0.10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.3.8",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "^1.62.1",
    "@portfolio-stack/config": "workspace:*",
    "@types/node": "catalog:",
    "happy-dom": "^20.8.4",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.13"
}
