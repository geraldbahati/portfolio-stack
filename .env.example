# Copy into apps/server/.env and apps/web/.env as noted.
# Never commit filled values.

# ---------------------------------------------------------------------------
# apps/server/.env
# ---------------------------------------------------------------------------

CORS_ORIGIN=http://localhost:4321
# Comma-separated for preview + prod, e.g.
# CORS_ORIGIN=http://localhost:4321,https://geraldbahati.dev
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_COOKIE_DOMAIN=
ENABLE_ADMIN=false
ENABLE_ADMIN_SEED=false
SEED_ADMIN_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ENVIRONMENT=development

# Production-only custom Worker domains. Keep WEB_REDIRECT_DOMAINS out of
# CORS_ORIGIN because redirects do not serve authenticated requests.
WEB_DOMAIN=
WEB_REDIRECT_DOMAINS=
SERVER_DOMAIN=

# Production observability. Sentry auth tokens remain build-only in apps/web.
SENTRY_DSN=
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Required in production. Register the production webhook at
# https://<SERVER_DOMAIN>/webhooks/resend and copy its signing secret here.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SENDER_EMAIL=Gerald Bahati <contact@geraldbahati.dev>
RECIPIENT_EMAIL=contact@geraldbahati.dev

# Optional contact-form spam
TURNSTILE_SECRET_KEY=

# Existing Cloudflare account (Stream + Images). Reuse the live portfolio.
CLOUDFLARE_ACCOUNT_ID=
# Least-privilege runtime token for Stream only. Alchemy deployment
# credentials are stored by `alchemy login` and must not be put here.
CLOUDFLARE_STREAM_API_TOKEN=
# Physical name of the live R2 bucket (custom domain: media.geraldbahati.dev).
R2_BUCKET_NAME=portfolio-store

# ---------------------------------------------------------------------------
# apps/web/.env
# ---------------------------------------------------------------------------

PUBLIC_SERVER_URL=http://localhost:3000
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=/gbx
PUBLIC_SENTRY_DSN=
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_STREAM_CUSTOMER=customer-pdxnd9di8ybc2kur.cloudflarestream.com
PUBLIC_MEDIA_ORIGIN=https://media.geraldbahati.dev
PUBLIC_IMAGE_TRANSFORM_ZONE=media.geraldbahati.dev
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Required for production source maps. Never prefix the auth token with PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=artlife-5r
SENTRY_PROJECT=portfolio
