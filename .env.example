# Copy into apps/server/.env and apps/web/.env as noted.
# Never commit filled values.

# ---------------------------------------------------------------------------
# apps/server/.env
# ---------------------------------------------------------------------------

CORS_ORIGIN=http://localhost:4321
# Comma-separated for preview + prod, e.g.
# CORS_ORIGIN=http://localhost:4321,https://geraldbahati.dev,https://www.geraldbahati.dev
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_COOKIE_DOMAIN=
ENABLE_ADMIN=false
SEED_ADMIN_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ENVIRONMENT=development

# Optional observability (server-side PostHog + Sentry)
SENTRY_DSN=
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Optional email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SENDER_EMAIL=Gerald Bahati <contact@geraldbahati.dev>
RECIPIENT_EMAIL=contact@geraldbahati.dev

# Optional contact-form spam
TURNSTILE_SECRET_KEY=

# Existing Cloudflare account (Stream + Images). Reuse the live portfolio.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Physical name of the live R2 bucket (custom domain: media.geraldbahati.dev).
R2_BUCKET_NAME=

# ---------------------------------------------------------------------------
# apps/web/.env
# ---------------------------------------------------------------------------

PUBLIC_SERVER_URL=http://localhost:3000
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=/gbx
PUBLIC_SENTRY_DSN=
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_STREAM_CUSTOMER=customer-pdxnd9di8ybc2kur.cloudflarestream.com
PUBLIC_MEDIA_ORIGIN=https://media.geraldbahati.dev
PUBLIC_IMAGE_TRANSFORM_ZONE=media.geraldbahati.dev
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Build-only Sentry source maps. Never prefix these with PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=artlife-5r
SENTRY_PROJECT=portfolio
