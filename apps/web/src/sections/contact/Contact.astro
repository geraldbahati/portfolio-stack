---
import {
  CONTACT_ARIA,
  CONTACT_HEADING_LEFT,
  CONTACT_HEADING_RIGHT,
  CONTACT_HREF,
  CONTACT_SECTION_LABEL,
  LEFT_SCRAMBLE_SPEED,
  RIGHT_SCRAMBLE_SPEED,
} from "./copy";
import "./contact.css";
---

<div class="bg-black" id="ContactSection">
  <section
    data-section-id="contact"
    data-contact
    class="short:h-[50vh] short:p-4 relative flex h-[60vh] items-center justify-center bg-black px-4 py-8 sm:p-8"
    aria-label={CONTACT_SECTION_LABEL}
  >
    <div data-grid-pattern-slot class="absolute inset-0 z-0" aria-hidden="true">
      <svg class="pointer-events-none absolute inset-0 h-full w-full stroke-muted-foreground/20">
        <defs>
          <pattern id="contact-grid" width="32" height="32" patternUnits="userSpaceOnUse" x="-1" y="-1">
            <path d="M.5 32V.5H32" fill="none"></path>
          </pattern>
        </defs>
        <rect data-grid-base width="100%" height="100%" stroke-width="0" fill="url(#contact-grid)"></rect>
        <g data-grid-highlights></g>
      </svg>
    </div>

    <div class="grid-interaction-blocked relative z-10 mx-auto w-full max-w-7xl text-center">
      <div
        data-contact-hover-target="true"
        class="contact-cta short:h-24 relative mx-auto h-32 w-full max-w-7xl sm:h-36 md:h-32 lg:h-28"
      >
        <h2
          class="absolute inset-0 flex items-center justify-center text-[clamp(1rem,5vw,4rem)] leading-tight font-light tracking-wide text-white drop-shadow-2xl"
        >
          <a
            href={CONTACT_HREF}
            data-contact-cta
            class="group inline-block rounded-lg whitespace-nowrap text-center transition-opacity duration-300 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black focus-visible:outline-none"
            aria-label={CONTACT_ARIA}
          >
            <span
              data-contact-phrase="true"
              class="contact-cta__phrase relative inline-block border-b whitespace-nowrap"
            >
              <span aria-hidden="true" class="invisible">{CONTACT_HEADING_LEFT}</span>
              <span
                aria-hidden="true"
                data-scramble
                data-original={CONTACT_HEADING_LEFT}
                data-scramble-speed={LEFT_SCRAMBLE_SPEED}
                class="absolute inset-0 text-center whitespace-nowrap"
              >
                {CONTACT_HEADING_LEFT}
              </span>
            </span>
            {" "}
            <span aria-hidden="true" data-contact-media="true" class="contact-cta__media"></span>
            <span
              data-contact-phrase="true"
              class="contact-cta__phrase relative inline-block border-b whitespace-nowrap"
            >
              <span aria-hidden="true" class="invisible">{CONTACT_HEADING_RIGHT}</span>
              <span
                aria-hidden="true"
                data-scramble
                data-original={CONTACT_HEADING_RIGHT}
                data-scramble-speed={RIGHT_SCRAMBLE_SPEED}
                class="absolute inset-0 text-center whitespace-nowrap"
              >
                {CONTACT_HEADING_RIGHT}
              </span>
            </span>
            <span class="contact-cta__arrow" aria-hidden="true">
              <svg
                class="h-6 w-6 sm:h-8 sm:w-8 md:h-10 md:w-10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 7h10v10"></path>
                <path d="M7 17 17 7"></path>
              </svg>
            </span>
          </a>
        </h2>
      </div>
    </div>
  </section>
</div>

<script>
  import "./boot";
</script>
