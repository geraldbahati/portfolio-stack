---
import type { PublishedCaseStudy } from "@portfolio-stack/api/routers/projects";

import { CUSTOMER_LABEL, FEATURES_LABEL, PERFORMANCE_LABEL, PERIOD_LABEL } from "./copy";
import { renderMarkdown } from "./markdown";

interface Props {
  details: NonNullable<PublishedCaseStudy["details"]>;
}

const { details } = Astro.props;
const description = renderMarkdown(details.fullDescription);
const colors = details.colorPalette ?? [];
const services = details.services ?? [];
const features = details.features ?? [];
---

{
  details.tagline || description ? (
    <section class="relative z-20 mx-auto max-w-6xl bg-background px-4 py-20 md:px-6 md:py-24">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-24">
        <div class="space-y-8 lg:col-span-7" data-reveal="up">
          {details.tagline && (
            <h2 class="text-2xl font-medium leading-tight tracking-tight text-foreground md:text-3xl lg:text-4xl">
              {details.tagline}
            </h2>
          )}
          {description && <div class="project-prose" set:html={description} />}
          <div class="space-y-4 pt-8">
            {details.client && (
              <div class="flex items-baseline gap-2">
                <h3 class="shrink-0 text-xs font-bold tracking-widest text-foreground uppercase">{CUSTOMER_LABEL}</h3>
                <span class="text-xs font-medium tracking-wider text-foreground uppercase">{details.client}</span>
              </div>
            )}
            {details.period && (
              <div class="flex items-baseline gap-2">
                <h3 class="shrink-0 text-xs font-bold tracking-widest text-foreground uppercase">{PERIOD_LABEL}</h3>
                <span class="text-xs font-medium tracking-wider text-foreground uppercase">{details.period}</span>
              </div>
            )}
            {services.length > 0 && (
              <div class="space-y-3 pt-2">
                <h3 class="text-xs font-bold tracking-widest text-foreground uppercase">{PERFORMANCE_LABEL}</h3>
                <div class="flex flex-wrap gap-2">
                  {services.map((item) => (
                    <span class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            )}
            {features.length > 0 && (
              <div class="space-y-3 pt-2">
                <h3 class="text-xs font-bold tracking-widest text-foreground uppercase">{FEATURES_LABEL}</h3>
                <div class="flex flex-wrap gap-2">
                  {features.map((item) => (
                    <span class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
        <div class="space-y-4 lg:col-span-4 lg:col-start-9">
          {colors.map((color, index) => (
            <div class="group" data-reveal="up" style={`--d: ${100 + index * 100}ms`}>
              <div
                class="h-24 w-full rounded-sm shadow-sm transition-transform duration-300 group-hover:scale-[1.02]"
                style={`background-color: ${color.hex}`}
              >
              </div>
              <p class="mt-2 text-xs font-medium tracking-wider text-muted-foreground uppercase">
                {color.name || color.hex}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : null
}
