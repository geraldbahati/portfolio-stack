---
import { PUBLIC_IMAGE_TRANSFORM_ZONE } from "astro:env/client";
import type { PublishedCaseStudy } from "@portfolio-stack/api/routers/projects";

import Picture from "../../components/Picture.astro";
import { IMAGE_PRESETS } from "../../lib/image-presets";
import { r2OptimizedImage } from "../../lib/remote-image";

interface Props {
  testimonial: NonNullable<PublishedCaseStudy["testimonial"]>;
}

const { testimonial } = Astro.props;
const avatar = testimonial.authorImage
  ? r2OptimizedImage(
      testimonial.authorImage,
      IMAGE_PRESETS.projectAvatar,
      { width: 320, height: 320 },
      PUBLIC_IMAGE_TRANSFORM_ZONE,
      { fit: "cover" },
    )
  : null;
---

<section class="project-deferred-section bg-background">
  <div class="container mx-auto py-24 md:py-32">
    <div class="px-4 md:px-8">
      <div class:list={["flex items-start gap-8", avatar ? "flex-col md:flex-row md:items-center gap-12" : "flex-col md:flex-row w-full"]}>
        {
          avatar ? (
            <div class="relative h-32 w-32 shrink-0 overflow-hidden rounded-full md:h-40 md:w-40" data-reveal="zoom">
              <Picture src={avatar} alt={testimonial.authorName} imgClass="h-full w-full object-cover" />
            </div>
          ) : (
            <div class="shrink-0" data-reveal="zoom" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 16 16" fill="none" class="text-foreground">
                <path d="M5.29 1.29L6.71 2.71L3 6.41V7H7V14H1V5.59L5.29 1.29Z" fill="currentColor"></path>
                <path d="M15 7H11V6.41L14.71 2.71L13.29 1.29L9 5.59V14H15V7Z" fill="currentColor"></path>
              </svg>
            </div>
          )
        }
        <div class="flex-1 space-y-6">
          <p class="text-lg font-normal text-foreground md:text-xl md:leading-relaxed" data-reveal="up">
            {testimonial.quote}
          </p>
          <div class="space-y-1" data-reveal="up">
            <h3 class="text-xs font-bold tracking-widest text-foreground uppercase">{testimonial.authorName}</h3>
            {(testimonial.authorRole || testimonial.authorCompany) && (
              <p class="text-xs tracking-wide text-muted-foreground uppercase">
                {testimonial.authorRole}
                {testimonial.authorRole && testimonial.authorCompany && " · "}
                {testimonial.authorCompany}
              </p>
            )}
          </div>
        </div>
      </div>
      <div class="mt-20 w-full overflow-hidden opacity-30" data-reveal="fade" aria-hidden="true">
        <svg class="h-auto w-full" viewBox="0 0 1200 5" fill="none">
          <line x1="0" y1="2.5" x2="1200" y2="2.5" stroke="currentColor" stroke-width="0.5" stroke-linecap="round"></line>
        </svg>
      </div>
    </div>
  </div>
</section>
