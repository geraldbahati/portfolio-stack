---
import {
  adminActivityCategorySchema,
  auditActionLabel,
  auditMetadataSummary,
  auditOutcomeLabel,
} from "@portfolio-stack/api/schemas/admin/activity";

import AdminHeader from "../../../components/admin/AdminHeader.astro";
import AdminNotice from "../../../components/admin/AdminNotice.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createServerOrpc } from "../../../lib/data/orpc";

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect("/login?returnTo=%2Fadmin%2Factivity", 302);

const params = Astro.url.searchParams;
const search = params.get("q")?.trim().slice(0, 120) ?? "";
const parsedCategory = adminActivityCategorySchema.safeParse(params.get("category"));
const category = parsedCategory.success ? parsedCategory.data : "all";
const datePattern = /^\d{4}-\d{2}-\d{2}$/;
const from = datePattern.test(params.get("from") ?? "") ? (params.get("from") ?? "") : "";
const to = datePattern.test(params.get("to") ?? "") ? (params.get("to") ?? "") : "";
const cursor = params.get("cursor")?.slice(0, 100) ?? "";
const direction = params.get("dir") === "newer" ? "newer" : "older";
const includeTotal = params.get("count") === "1";
const hasFilters = Boolean(search || category !== "all" || from || to);

const api = createServerOrpc(Astro.request.headers.get("cookie"));
type ActivityList = Awaited<ReturnType<typeof api.admin.activity.list>>;
let result: ActivityList | null = null;
try {
  result = await api.admin.activity.list({
    search,
    category,
    ...(from ? { from } : {}),
    ...(to ? { to } : {}),
    ...(cursor ? { cursor, direction } : {}),
    pageSize: 30,
    includeTotal,
  });
} catch (cause) {
  // The protected shell renders an explicit unavailable state below.
  Astro.locals.telemetry?.captureException(cause, { operation: "admin.activity.list" });
}

const categories = ["auth", "project", "message", "media", "settings", "stream"] as const;
const dateTimeFormatter = new Intl.DateTimeFormat("en-KE", {
  dateStyle: "medium",
  timeStyle: "medium",
  timeZone: "Africa/Nairobi",
});

function activityHref(overrides: Record<string, string | null>) {
  const next = new URLSearchParams();
  if (search) next.set("q", search);
  if (category !== "all") next.set("category", category);
  if (from) next.set("from", from);
  if (to) next.set("to", to);
  if (includeTotal) next.set("count", "1");
  for (const [key, value] of Object.entries(overrides)) {
    if (value === null) next.delete(key);
    else next.set(key, value);
  }
  const query = next.toString();
  return `/admin/activity${query ? `?${query}` : ""}`;
}

function targetHref(entityType: string, entityId: string | null) {
  if (entityType === "project" && entityId) {
    return `/admin/projects/${encodeURIComponent(entityId)}/edit`;
  }
  if (entityType === "media") return "/admin/media";
  if (entityType === "site-settings") return "/admin/settings";
  return null;
}
---

<AdminLayout
  title="Activity"
  description="Review the immutable operational history of admin mutations."
  user={admin}
>
  <AdminHeader
    eyebrow="Audit history"
    title="Activity"
    description="Review who changed portfolio data or signed in, what operation ran, how it ended, and which record it affected. This history is read-only."
  />

  {!result && <AdminNotice kind="error" message="Activity data is temporarily unavailable." />}

  <form method="get" action="/admin/activity" class="admin-project-filters" role="search">
    <label class="admin-search-field">
      <span class="sr-only">Search activity</span>
      <input name="q" value={search} type="search" maxlength="120" placeholder="Search action, actor, entity, operation, or request ID" />
    </label>
    <label class="admin-filter-field">
      <span class="sr-only">Activity category</span>
      <select name="category">
        <option value="all" selected={category === "all"}>All activity</option>
        {categories.map((item) => <option value={item} selected={category === item}>{item}</option>)}
      </select>
    </label>
    <label class="admin-filter-field admin-filter-field--date">
      <span class="sr-only">From date</span>
      <input name="from" type="date" value={from} aria-label="From date" />
    </label>
    <label class="admin-filter-field admin-filter-field--date">
      <span class="sr-only">To date</span>
      <input name="to" type="date" value={to} aria-label="To date" />
    </label>
    <button type="submit" class="admin-button admin-button--secondary">Apply filters</button>
    {hasFilters && <a href="/admin/activity" class="admin-filter-reset">Reset</a>}
  </form>

  <section class="admin-activity-log" aria-labelledby="activity-log-heading">
    <header class="admin-project-table__header">
      <div>
        <h2 id="activity-log-heading">Audit events</h2>
        {result?.total != null ? (
          <p>{result.total} {result.total === 1 ? "event" : "events"} match these filters</p>
        ) : (
          <p>
            Newest first · <a href={activityHref({ count: "1", cursor: null, dir: null })}>Count matching events</a>
          </p>
        )}
      </div>
    </header>

    {result?.items.length ? (
      <ol class="admin-activity-list">
        {result.items.map((event) => {
          const summary = auditMetadataSummary(event.metadata);
          const href = targetHref(event.entityType, event.entityId);
          const eventCategory = event.action.split(".")[0] ?? "system";
          return (
            <li class="admin-activity-event">
              <span class:list={["admin-activity-event__marker", `is-${eventCategory}`]} aria-hidden="true" />
              <article>
                <header>
                  <div>
                    <span class="admin-activity-event__category">{eventCategory}</span>
                    <h3>{auditActionLabel(event.action)}</h3>
                  </div>
                  <time datetime={new Date(event.createdAt).toISOString()}>{dateTimeFormatter.format(new Date(event.createdAt))}</time>
                </header>
                <div class="admin-activity-event__context">
                  <span class:list={["admin-activity-event__outcome", `is-${event.outcome}`]}>
                    {auditOutcomeLabel(event.outcome)}
                  </span>
                  <span>Actor <strong>{event.actorEmail}</strong></span>
                  <span>Entity <strong>{event.entityType}</strong></span>
                  {event.entityId && <code>{event.entityId}</code>}
                  {event.operationId && <code title="Operation ID">op {event.operationId}</code>}
                  {event.requestId && <code title="Request ID">req {event.requestId}</code>}
                </div>
                {(summary.length > 0 || href) && (
                  <footer>
                    {summary.length > 0 && <span>{summary.join(" · ")}</span>}
                    {href && <a href={href}>Open target</a>}
                  </footer>
                )}
              </article>
            </li>
          );
        })}
      </ol>
    ) : result ? (
      <div class="admin-project-empty">
        <span aria-hidden="true">00</span>
        <h2>{hasFilters ? "No events match these filters" : "No audit events yet"}</h2>
        <p>{hasFilters ? "Try a broader search or reset the filters." : "Admin changes and sign-ins will appear here."}</p>
      </div>
    ) : null}
  </section>

  {result && (result.newerCursor || result.olderCursor) && (
    <nav class="admin-pagination" aria-label="Activity pages">
      {result.newerCursor ? (
        <a href={activityHref({ cursor: result.newerCursor, dir: "newer" })}>Newer</a>
      ) : (
        <span aria-disabled="true">Newer</span>
      )}
      {result.newerCursor ? <a href={activityHref({ cursor: null, dir: null })}>Latest</a> : <strong>Latest</strong>}
      {result.olderCursor ? (
        <a href={activityHref({ cursor: result.olderCursor, dir: "older" })}>Older</a>
      ) : (
        <span aria-disabled="true">Older</span>
      )}
    </nav>
  )}
</AdminLayout>
