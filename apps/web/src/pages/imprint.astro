---
import ImprintPage from "../features/imprint-page/ImprintPage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { simplePageJsonLd } from "../lib/seo/json-ld";
import { PAGE_COPY } from "../lib/seo/page-copy";
---

<SiteLayout
  title={PAGE_COPY.imprint.title}
  description={PAGE_COPY.imprint.description}
  keywords={PAGE_COPY.imprint.keywords}
  indexable={PAGE_COPY.imprint.indexable}
  jsonLd={simplePageJsonLd(PAGE_COPY.imprint)}
>
  <ImprintPage />
</SiteLayout>
