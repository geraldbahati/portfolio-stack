---
import SectionDivider from "../components/SectionDivider.astro";
import Contact from "../features/contact/Contact.astro";
import HeroBio from "../features/hero-bio/HeroBio.astro";
import { SERVICES_DIVIDER } from "../features/info/copy";
import Info from "../features/info/Info.astro";
import { FAQ_ENTRIES, PROJECTS_DIVIDER } from "../features/projects-faq/copy";
import ProjectsFaq from "../features/projects-faq/ProjectsFaq.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { loadPublishedProjects } from "../lib/data/projects";
import { hero } from "../lib/images/site-images";
import { homepageJsonLd } from "../lib/seo/json-ld";
import { PAGE_COPY } from "../lib/seo/page-copy";

const projects = await loadPublishedProjects();
---

<SiteLayout
  title={PAGE_COPY.home.title}
  description={PAGE_COPY.home.description}
  keywords={PAGE_COPY.home.keywords}
  theme="home"
  ogType="profile"
  jsonLd={homepageJsonLd(FAQ_ENTRIES)}
  lcpImage={hero.preload}
>
  <HeroBio />
  <section class="relative bg-white py-16 text-foreground sm:py-20 lg:py-24">
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionDivider label={SERVICES_DIVIDER.label} counter={SERVICES_DIVIDER.counter} />
    </div>
  </section>
  <Info />
  <section class="relative bg-white py-16 text-foreground">
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionDivider label={PROJECTS_DIVIDER.label} counter={PROJECTS_DIVIDER.counter} />
    </div>
  </section>
  <ProjectsFaq projects={projects} />
  <Contact />
</SiteLayout>
