---
import { PUBLIC_IMAGE_TRANSFORM_ZONE, PUBLIC_STREAM_CUSTOMER } from "astro:env/client";
import ProjectsIndex from "../features/projects-index/ProjectsIndex.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { loadPublishedProjects } from "../lib/data/projects";
import { IMAGE_PRESETS } from "../lib/images/image-presets";
import { projectMediaAssets, projectPosterPreload } from "../lib/project-media/poster";
import { projectsIndexJsonLd } from "../lib/seo/json-ld";
import { PAGE_COPY } from "../lib/seo/page-copy";

const projects = await loadPublishedProjects();
const first = projects[0];
const media = first
  ? projectMediaAssets(
      first,
      {
        streamCustomer: PUBLIC_STREAM_CUSTOMER,
        transformZone: PUBLIC_IMAGE_TRANSFORM_ZONE,
      },
      { sizes: IMAGE_PRESETS.projectIndex.sizes },
    )
  : null;
const lcpImage = media ? projectPosterPreload(media) : null;
---

<SiteLayout
  title={PAGE_COPY.projects.title}
  description={PAGE_COPY.projects.description}
  keywords={PAGE_COPY.projects.keywords}
  jsonLd={projectsIndexJsonLd(projects)}
  lcpImage={lcpImage ?? undefined}
  ogImage={media?.posterSrc ?? undefined}
  ogImageAlt={first ? `${first.title} — case study preview` : undefined}
>
  <ProjectsIndex projects={projects} />
</SiteLayout>
