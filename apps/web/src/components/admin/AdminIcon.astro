---
import type { AdminIconName } from "../../lib/admin/navigation";

interface Props {
  name: AdminIconName | "arrow" | "external" | "menu";
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === "overview" && (
      <>
        <rect x="3" y="3" width="7" height="7" rx="1.5" />
        <rect x="14" y="3" width="7" height="7" rx="1.5" />
        <rect x="3" y="14" width="7" height="7" rx="1.5" />
        <rect x="14" y="14" width="7" height="7" rx="1.5" />
      </>
    )
  }
  {
    name === "activity" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
        <path d="M7 4.5 4.5 7M17 4.5 19.5 7" />
      </>
    )
  }
  {
    name === "projects" && (
      <>
        <path d="M4 7.5h16" />
        <path d="M7 3.5h10a2 2 0 0 1 2 2v15H5v-15a2 2 0 0 1 2-2Z" />
        <path d="M8.5 12h7M8.5 16h5" />
      </>
    )
  }
  {
    name === "messages" && (
      <>
        <path d="M4 5.5h16v11H8l-4 4v-15Z" />
        <path d="M8 9h8M8 13h5" />
      </>
    )
  }
  {
    name === "media" && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <circle cx="8.5" cy="9" r="1.5" />
        <path d="m5 18 5-5 3 3 2-2 4 4" />
      </>
    )
  }
  {
    name === "settings" && (
      <>
        <circle cx="12" cy="12" r="3" />
        <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21h-4v-.09A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3v-4h.09A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.09A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.38.28.74.62 1 .99.26.37.4.8.4 1.21v.4h.2v4h-.09A1.7 1.7 0 0 0 19.4 15Z" />
      </>
    )
  }
  {name === "arrow" && <path d="m9 18 6-6-6-6" />}
  {
    name === "external" && (
      <>
        <path d="M14 4h6v6" />
        <path d="m20 4-9 9" />
        <path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6" />
      </>
    )
  }
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
</svg>
