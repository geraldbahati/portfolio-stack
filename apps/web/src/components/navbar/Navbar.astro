---
import { logo, overlay } from "../../lib/images/site-images";
import { MENU_ITEMS, SOCIAL_LINKS } from "../../lib/navigation";
import Picture from "../Picture.astro";
import SocialIcon from "../SocialIcon.astro";
import {
  ITEM_ENTER_DELAYS,
  ITEM_EXIT_DELAYS,
  SOCIAL_ENTER_DELAYS,
  SOCIAL_EXIT_DELAYS,
} from "./delays";

interface Props {
  socialLinks?: Array<{ id: string; href: string; label: string }>;
}

const { socialLinks = [...SOCIAL_LINKS] } = Astro.props;

const socialClass =
  "text-white hover:opacity-70 hover:scale-[1.2] hover:rotate-[5deg] active:scale-90 transition-[color,background-color,border-color,opacity,transform,box-shadow,filter] duration-300 cursor-pointer";
const isHome = Astro.url.pathname === "/";
/**
 * `me` is how Google and the IndieWeb reconcile these accounts with the Person
 * in the JSON-LD graph. The document head already carries `<link rel="me">`;
 * these anchors are the half a crawler actually follows.
 */
const SOCIAL_REL = "me noopener noreferrer";
---

<nav
  data-site-nav
  class="fixed top-0 right-0 left-0 z-50 mix-blend-difference"
  aria-label="Primary"
>
  <div class="relative mx-auto px-6 lg:px-12">
    <div class="short:py-3 relative flex items-center justify-between py-6">
      <a
        href="/"
        data-astro-prefetch="hover"
        data-nav-logo
        class="animate-nav-slide-down relative block cursor-pointer transition-transform duration-200 hover:scale-105 active:scale-95"
        style="animation-delay: 0.2s"
        aria-label="Home"
      >
        <Picture
          src={logo}
          alt=""
          imgClass="short:h-14 short:w-14 h-12 w-12 invert brightness-0 transition-[color,background-color,border-color,opacity,transform,box-shadow,filter] duration-300 sm:h-14 sm:w-14 md:h-14 md:w-14 lg:h-16 lg:w-16 xl:h-20 xl:w-20"
          class="block"
          loading="eager"
          fetchpriority={isHome ? "low" : "high"}
        />
      </a>

      <button
        type="button"
        data-menu-toggle
        class="animate-nav-slide-down relative z-50 flex h-12 w-12 flex-col items-center justify-center transition-transform duration-200 hover:scale-110 active:scale-90"
        style="animation-delay: 0.3s"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="relative flex h-6 w-8 flex-col justify-center">
          <span data-menu-bar="top" class="absolute h-0.5 w-full bg-white"></span>
          <span data-menu-bar="bottom" class="absolute h-0.5 w-full bg-white"></span>
        </span>
      </button>
    </div>
  </div>
</nav>

<div
  id="site-menu"
  data-site-menu
  hidden
  inert
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  class="fixed inset-0 z-40 bg-black"
>
  <div class="container mx-auto flex h-full px-6 lg:px-12">
    <div
      class="short:py-16 flex h-full w-full flex-col py-12 sm:py-16 lg:flex-row lg:py-32"
    >
      <div class="flex flex-1 flex-col items-center justify-center lg:relative lg:items-start">
        <nav class="mb-8 flex w-full justify-center lg:mb-0 lg:justify-start" aria-label="Menu">
          <ul class="short:space-y-3 space-y-4 text-center sm:space-y-6 lg:space-y-8 lg:text-left">
            {
              MENU_ITEMS.map((item, index) => (
                <li
                  data-enter="animate-nav-item-enter"
                  data-exit="animate-nav-item-exit"
                  data-enter-delay={`${ITEM_ENTER_DELAYS[index]}s`}
                  data-exit-delay={`${ITEM_EXIT_DELAYS[index]}s`}
                >
                  <a
                    href={item.href}
                    data-astro-prefetch="hover"
                    data-menu-link
                    data-label={item.label}
                    class="short:text-5xl block cursor-pointer text-3xl font-medium text-white transition-[color,background-color,border-color,opacity,transform,box-shadow,filter] duration-300 hover:tracking-[0.1em] hover:text-primary sm:text-4xl lg:text-6xl xl:text-8xl"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="absolute bottom-0 left-0 hidden gap-4 lg:flex">
          {
            socialLinks.map((social, index) => (
              <a
                href={social.href}
                target="_blank"
                rel={SOCIAL_REL}
                aria-label={social.label}
                data-social-link
                data-label={social.label}
                data-enter="animate-nav-social-enter"
                data-exit="animate-nav-social-exit"
                data-enter-delay={`${SOCIAL_ENTER_DELAYS[index]}s`}
                data-exit-delay={`${SOCIAL_EXIT_DELAYS[index]}s`}
                class={socialClass}
              >
                <SocialIcon id={social.id} />
              </a>
            ))
          }
        </div>
      </div>

      <div class="relative mt-8 flex flex-1 flex-col items-center justify-center lg:mt-0">
        <div
          data-enter="animate-nav-image-enter"
          data-exit="animate-nav-image-exit"
          class="relative h-80 w-64 sm:h-88 sm:w-72 md:h-96 md:w-80 lg:aspect-[5/6] lg:h-[min(600px,calc(100vh_-_18rem))] lg:w-auto xl:aspect-[6/7] xl:h-[min(700px,calc(100vh_-_18rem))]"
        >
          <div class="group relative h-full w-full overflow-hidden">
            <div class="absolute inset-0 bg-linear-to-b from-transparent via-gray-900/20 to-gray-900/40"></div>
            <Picture
              src={overlay}
              alt="Gerald Bahati"
              deferred
              loading="eager"
              fetchpriority="high"
              class="block h-full w-full"
              imgClass="h-full w-full object-cover grayscale"
            />
            <div class="absolute inset-0 bg-black opacity-0 transition-opacity duration-300 group-hover:opacity-20"></div>
          </div>
          <div
            class="animate-glitch-shimmer absolute inset-0 mix-blend-screen opacity-30"
            style="background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.1) 50%, transparent 70%); background-size: 200% 200%"
          >
          </div>
        </div>

        <div class="mt-6 flex w-full justify-center gap-4 lg:hidden">
          {
            socialLinks.map((social, index) => (
              <a
                href={social.href}
                target="_blank"
                rel={SOCIAL_REL}
                aria-label={social.label}
                data-social-link
                data-label={social.label}
                data-enter="animate-nav-social-enter"
                data-exit="animate-nav-social-exit"
                data-enter-delay={`${SOCIAL_ENTER_DELAYS[index]}s`}
                data-exit-delay={`${SOCIAL_EXIT_DELAYS[index]}s`}
                class={socialClass}
              >
                <SocialIcon id={social.id} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
