---
import ConsentBanner from "../components/ConsentBanner.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
import { PUBLIC_GOOGLE_SITE_VERIFICATION, PUBLIC_POSTHOG_KEY } from "astro:env/client";

interface Props {
  title?: string;
}

const { title = "portfolio-stack" } = Astro.props;
const posthogEnabled = Boolean(PUBLIC_POSTHOG_KEY) && import.meta.env.PROD;
---

<!doctype html>
<html lang="en" class="dark" data-posthog-enabled={posthogEnabled ? "true" : "false"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={PUBLIC_GOOGLE_SITE_VERIFICATION}
      />
    )}
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-neutral-950 text-white">
    <Header />
    <slot />
    <ConsentBanner />
    <script>
      import "../client-observability";
    </script>
  </body>
</html>
