---
import {
  PUBLIC_GOOGLE_SITE_VERIFICATION,
  PUBLIC_MEDIA_ORIGIN,
  PUBLIC_POSTHOG_KEY,
  PUBLIC_STREAM_CUSTOMER,
} from "astro:env/client";
import syneLatin from "@fontsource-variable/syne/files/syne-latin-wght-normal.woff2?url";

import ConsentBanner from "../components/ConsentBanner.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import type { ImagePreload } from "../lib/image-presets";
import {
  canonicalUrl,
  personJsonLd,
  SITE_DESCRIPTION,
  SITE_LANGUAGE,
  SITE_NAME,
  SITE_TITLE,
  SOCIAL_PROFILES,
} from "../lib/site";
import { logo } from "../lib/site-images";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  theme?: "home" | "page";
  lcpImage?: ImagePreload;
  ogImage?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  robots?: string;
  jsonLd?: unknown;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  theme = "page",
  lcpImage,
  ogImage,
  ogType = "website",
  publishedTime,
  modifiedTime,
  robots,
  jsonLd = personJsonLd(),
} = Astro.props;

const canonical = canonicalUrl(Astro.url.pathname);
const posthogEnabled = Boolean(PUBLIC_POSTHOG_KEY) && import.meta.env.PROD;
const streamOrigin = `https://${PUBLIC_STREAM_CUSTOMER}`;
---

<!doctype html>
<html lang={SITE_LANGUAGE} data-posthog-enabled={posthogEnabled ? "true" : "false"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === "home" ? "#000000" : "#f5f4ef"} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-KE" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_KE" />
    {
      publishedTime && <meta property="article:published_time" content={publishedTime} />
    }
    {
      modifiedTime && <meta property="article:modified_time" content={modifiedTime} />
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@gerald_baha" />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta name="twitter:image" content={ogImage} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={syneLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href={streamOrigin} crossorigin />
    <link rel="dns-prefetch" href={PUBLIC_MEDIA_ORIGIN} />
    {
      lcpImage ? (
        <link
          rel="preload"
          as="image"
          type={lcpImage.type}
          href={lcpImage.href}
          imagesrcset={lcpImage.imagesrcset}
          imagesizes={lcpImage.imagesizes}
        />
      ) : (
        <link
          rel="preload"
          as="image"
          type={logo.preload.type}
          href={logo.preload.href}
          imagesrcset={logo.preload.imagesrcset}
          imagesizes={logo.preload.imagesizes}
        />
      )
    }
    {SOCIAL_PROFILES.map((profile) => <link rel="me" href={profile} />)}
    {
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />
      )
    }
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body
    class:list={[
      "antialiased font-sans",
      theme === "home" ? "bg-black text-white" : "bg-background text-foreground",
    ]}
  >
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script>
      import "../lib/site-chrome";
    </script>
    <script>
      const boot = () => import("../client-observability");
      if ("requestIdleCallback" in window) {
        requestIdleCallback(() => void boot(), { timeout: 4000 });
      } else {
        setTimeout(() => void boot(), 1);
      }
    </script>
  </body>
</html>
