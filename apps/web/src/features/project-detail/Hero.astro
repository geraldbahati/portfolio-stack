---
import Picture from "../../components/Picture.astro";
import type { OptimizedImage } from "../../lib/images/image-presets";
import { PROJECTS_CRUMB } from "./copy";

interface Props {
  title: string;
  hero?: {
    src: OptimizedImage;
    alt: string;
  } | null;
}

const { title, hero } = Astro.props;
---

<section class="relative w-full max-w-6xl mx-auto px-4 pt-32 md:px-6" data-reveal="up">
  <div class="mb-8 max-w-4xl md:mb-12">
    <h1 class="mb-4 text-4xl font-medium tracking-tight text-foreground md:text-5xl lg:text-6xl" data-reveal="up">
      {title}
    </h1>
    <nav class="flex items-center gap-2 text-sm font-medium text-muted-foreground" aria-label="Breadcrumb" data-reveal="left">
      <a href="/projects" data-astro-prefetch="hover" class="transition-colors hover:text-foreground">{PROJECTS_CRUMB}</a>
      <svg class="h-3 w-3 text-muted-foreground/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m9 18 6-6-6-6"></path>
      </svg>
      <span class="font-semibold text-foreground">{title}</span>
    </nav>
  </div>
  {
    hero && (
      <div class="relative aspect-[21/9] w-full overflow-hidden rounded-2xl md:aspect-[2.35/1]" data-reveal="zoom">
        <Picture
          src={hero.src}
          alt={hero.alt}
          class="absolute inset-0 h-full w-full"
          imgClass="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </div>
    )
  }
</section>
