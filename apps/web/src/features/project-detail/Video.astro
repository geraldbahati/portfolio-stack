---
import { PUBLIC_IMAGE_TRANSFORM_ZONE, PUBLIC_STREAM_CUSTOMER } from "astro:env/client";
import type { PublishedProject } from "@portfolio-stack/api/routers/projects";

import "../../components/project-card/project-card.css";
import { projectMediaAssets } from "../../lib/project-media/poster";
import Arrow from "./Arrow.astro";
import { DOWN_ARROW, LOOP_ARROW, SWEEP_ARROW } from "./arrows";
import { LIVE_HINT, LIVE_HINT_MOBILE, LIVE_HINT_VISIT } from "./copy";

interface Props {
  project: PublishedProject;
}

const { project } = Astro.props;
const media = projectMediaAssets(project, {
  streamCustomer: PUBLIC_STREAM_CUSTOMER,
  transformZone: PUBLIC_IMAGE_TRANSFORM_ZONE,
});
const hasUrl = Boolean(project.url);
const alt = project.alt || project.title;
---

{
  project.type === "video" && (
    <section class="project-deferred-section bg-background py-24" data-live-anchor>
      <div class="mx-auto max-w-4xl px-2">
        {hasUrl && (
          <div class="project-hint project-hint--tap" data-reveal="up" aria-hidden="true">
            <span class="project-hint__label">
              <span class="project-hint__verb project-hint__verb--touch">{LIVE_HINT_MOBILE}</span>
              <span class="project-hint__verb project-hint__verb--pointer">{LIVE_HINT_VISIT}</span>
            </span>
            <Arrow arrow={DOWN_ARROW} class="project-hint__arrow" />
          </div>
        )}
        <div class="project-showcase">
          {hasUrl && (
            <>
              <div class="project-hint project-hint--lead" data-reveal="up" aria-hidden="true">
                <span class="project-hint__label">{LIVE_HINT}</span>
                <Arrow arrow={SWEEP_ARROW} class="project-hint__arrow" />
              </div>
              <div class="project-hint project-hint--visit" data-reveal="up" aria-hidden="true">
                <span class="project-hint__label">{LIVE_HINT_VISIT}</span>
                <Arrow arrow={LOOP_ARROW} class="project-hint__arrow" />
              </div>
            </>
          )}
          <div
            data-showcase-video
            data-media-type="video"
            data-media-src={media.hlsSrc}
            data-live-url={project.url ?? undefined}
            class:list={[
              "project-card relative w-full overflow-hidden rounded-lg border border-black/10 shadow-2xl",
              hasUrl && "is-live",
            ]}
            style="aspect-ratio: 16 / 9; --mx: 50%; --my: 50%"
          >
            {hasUrl && (
              <div class="project-card__cursor" aria-hidden="true">
                View
                <svg class="ml-1 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </div>
            )}
            <div class="project-card__media absolute inset-0">
              {media.posterSrc && (
                <picture data-project-poster class="project-card__poster">
                  {media.sources.map((source) => (
                    <source type={source.type} srcset={source.srcset} sizes={media.sizes} />
                  ))}
                  <img
                    src={media.posterSrc}
                    srcset={media.srcset || undefined}
                    sizes={media.sizes}
                    alt=""
                    width="1280"
                    height="720"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              )}
              <video
                class="project-card__video"
                poster={media.nativePoster ?? undefined}
                muted
                loop
                playsinline
                preload="none"
                crossorigin="anonymous"
                aria-hidden="true"
              >
              </video>
              <div class="project-card__fallback">
                <span>Media unavailable</span>
              </div>
            </div>
            {project.url && <a href={project.url} data-live-link class="absolute inset-0 z-20" target="_blank" rel="noopener noreferrer" aria-label={`View ${alt} website`}></a>}
          </div>
        </div>
      </div>
    </section>
  )
}
