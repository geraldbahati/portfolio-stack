---
import { CTA_BODY, CTA_HEADING, CTA_HREF, CTA_LABEL } from "./copy";
---

<section data-project-cta class="relative overflow-hidden bg-black py-24 text-white md:py-32">
  <div data-grid-pattern-slot class="absolute inset-0 z-0" aria-hidden="true">
    <svg class="pointer-events-none absolute inset-0 h-full w-full stroke-white/10">
      <defs>
        <pattern id="project-cta-grid" width="32" height="32" patternUnits="userSpaceOnUse" x="-1" y="-1">
          <path d="M.5 32V.5H32" fill="none"></path>
        </pattern>
      </defs>
      <rect data-grid-base width="100%" height="100%" stroke-width="0" fill="url(#project-cta-grid)"></rect>
      <g data-grid-highlights></g>
    </svg>
  </div>
  <div class="relative z-10 flex w-full justify-center px-4">
    <div class="max-w-2xl space-y-6 text-center" data-reveal="up">
      <h2 class="text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">{CTA_HEADING}</h2>
      <p class="text-base text-white/70 md:text-lg">{CTA_BODY}</p>
      <div class="pt-4">
        <a
          href={CTA_HREF}
          data-astro-prefetch="hover"
          data-project-cta-link
          class="inline-block border-b border-white/50 pb-0.5 text-sm font-light tracking-[0.2em] text-white uppercase transition-[color,border-color,transform] duration-300 hover:scale-[1.02] hover:border-primary active:scale-[0.98]"
          aria-label={CTA_LABEL}
        >
          <span data-scramble data-original={CTA_LABEL}>{CTA_LABEL}</span>
        </a>
      </div>
    </div>
  </div>
</section>
