---
interface Props {
  label: string;
  title: string;
  description: string;
  bullets: readonly string[];
  index: number;
}

const { label, title, description, bullets, index } = Astro.props;
const chevron =
  "M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z";
---

<article data-text-section class="service-copy" style={`--i: ${index}`}>
  <div class="grid-interaction-blocked service-copy__label" data-label-wrap>
    <span class="text-accent-orange inline-block text-sm font-medium tracking-[0.2em] uppercase">
      {label}
    </span>
    <div data-label-underline class="bg-accent-orange-muted mt-3 h-px w-full"></div>
  </div>
  <h2
    class="grid-interaction-blocked mb-8 text-4xl font-bold tracking-tight sm:text-5xl lg:mb-12 lg:text-7xl short:mb-8 short:text-5xl"
  >
    {title}
  </h2>
  <p
    class="service-copy__body grid-interaction-blocked mb-8 max-w-lg text-base leading-relaxed lg:mb-12 short:mb-8"
  >
    {description}
  </p>
  <ul class="grid-interaction-blocked space-y-3 lg:space-y-4">
    {
      bullets.map((bullet, bulletIndex) => (
        <li class="flex items-start" style={`--bi: ${bulletIndex}`}>
          <svg
            class="mt-1.5 mr-3 h-4 w-4 shrink-0 lg:mr-4"
            fill="currentColor"
            viewBox="0 0 16 16"
            aria-hidden="true"
          >
            <path d={chevron}></path>
          </svg>
          <span class="text-base">{bullet}</span>
        </li>
      ))
    }
  </ul>
</article>
