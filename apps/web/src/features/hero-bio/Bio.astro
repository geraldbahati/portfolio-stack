---
import Picture from "../../components/Picture.astro";
import { bio } from "../../lib/images/site-images";
import CharText from "./CharText.astro";
import { BIO_BODY, BIO_CTA, BIO_NUMBER, BIO_TAGLINE, splitWords } from "./copy";

const tagline = splitWords(BIO_TAGLINE);
const numberOffset = tagline.charCount;
const bodyOffset = tagline.charCount + BIO_NUMBER.length;
const totalChars = tagline.charCount + BIO_NUMBER.length + splitWords(BIO_BODY).charCount;
---

<section
  data-section-id="bio"
  data-bio-section
  data-total-chars={totalChars}
  class="bio-scene relative flex h-screen items-center justify-center overflow-y-auto rounded-t-xl bg-linear-to-br from-gray-50 via-white to-gray-50 sm:rounded-t-2xl lg:rounded-t-4xl"
  aria-labelledby="bio-heading"
>
  <div data-bio-bg class="scroll-bio-bg pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute top-0 right-0 h-96 w-96 rounded-full bg-gradient-to-br from-purple-100/20 to-transparent blur-3xl">
    </div>
    <div class="absolute bottom-0 left-0 h-96 w-96 rounded-full bg-gradient-to-tr from-blue-100/20 to-transparent blur-3xl">
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-[210px_1fr] lg:gap-24 short:gap-12">
      <div data-bio-image class="scroll-bio-image flex justify-center lg:justify-start">
        <div class="w-full max-w-[282px]">
          <div class="cutout-mask relative w-full" role="img" aria-label="Gerald Bahati">
            <Picture
              src={bio}
              alt=""
              imgClass="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <div class="space-y-8 short:space-y-4">
        <div class="flex items-start justify-between">
          <p class="text-xs font-medium tracking-[0.2em] text-gray-600 uppercase sm:text-sm">
            <CharText text={BIO_TAGLINE} total={totalChars} />
          </p>
          <p class="text-xs font-light whitespace-nowrap text-gray-400 sm:text-sm">
            <CharText text={BIO_NUMBER} offset={numberOffset} total={totalChars} />
          </p>
        </div>

        <h2
          id="bio-heading"
          class="text-2xl leading-tight font-light text-gray-900 sm:text-3xl lg:text-4xl xl:text-5xl short:text-3xl"
        >
          <CharText text={BIO_BODY} offset={bodyOffset} total={totalChars} />
        </h2>

        <div data-bio-cta class="scroll-bio-cta">
          <a
            href="/projects"
            data-astro-prefetch="hover"
            class="bio-cta-button group inline-flex items-center gap-3 text-sm font-medium tracking-wider text-gray-900 uppercase transition-colors hover:text-gray-600"
          >
            <span class="relative">
              {BIO_CTA}
              <span
                class="absolute bottom-0 left-0 h-px w-full origin-left scale-x-100 bg-gray-900 transition-transform duration-300 group-hover:scale-x-[0.01]"
              >
              </span>
            </span>
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
