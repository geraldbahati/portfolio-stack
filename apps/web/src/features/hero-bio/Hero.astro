---
import Picture from "../../components/Picture.astro";
import { hero } from "../../lib/images/site-images";
import { HERO_CTA, HERO_DESCRIPTION, HERO_NAME, HERO_TITLE_LEFT, HERO_TITLE_RIGHT } from "./copy";
---

<section
  data-section-id="hero"
  class="hero-scene bg-hero-bg relative min-h-screen overflow-hidden"
  aria-label="Introduction"
>
  <div class="absolute inset-0 z-0 flex items-center justify-center">
    <div data-hero-scale class="scroll-hero-scale relative h-full w-full">
      <Picture
        src={hero}
        alt={`${HERO_NAME} - Full-Stack Software Engineer`}
        class="block h-full w-full"
        imgClass="h-full w-full object-cover sm:object-contain sm:mix-blend-screen"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <div class="hero-vignette-x"></div>
  <div class="hero-vignette-y"></div>

  <div data-grid-pattern-slot class="absolute inset-0 z-10" aria-hidden="true">
    <svg class="pointer-events-none absolute inset-0 h-full w-full stroke-white/10" aria-hidden="true">
      <defs>
        <pattern id="hero-grid" width="32" height="32" patternUnits="userSpaceOnUse" x="-1" y="-1">
          <path d="M.5 32V.5H32" fill="none"></path>
        </pattern>
      </defs>
      <rect data-grid-base width="100%" height="100%" stroke-width="0" fill="url(#hero-grid)"></rect>
      <g data-grid-highlights></g>
    </svg>
  </div>

  <div
    class="short:pb-8 pointer-events-none relative z-10 flex min-h-screen items-end justify-center px-4 pb-16 sm:px-6 sm:pb-12 lg:justify-end lg:px-8"
  >
    <div class="mx-auto w-full max-w-7xl text-center lg:text-left">
      <div class="short:mb-4 mb-8 overflow-hidden">
        <div class="reveal-up">
          {/*
            A <p>, not the <h1>. The name is set at 12px as an eyebrow while
            the role below it is the visually dominant heading, so making the
            eyebrow the h1 inverted the document outline. It also carries
            `data-scramble`, which rewrites its text to random characters for
            the first ~800ms — not what a renderer should snapshot as the
            page's primary heading.
          */}
          <p
            data-hero-name
            data-scramble
            data-original={HERO_NAME}
            class="text-xs font-light tracking-[0.2em] text-primary uppercase sm:text-sm sm:tracking-[0.3em] lg:text-base"
          >
            {HERO_NAME}
          </p>
        </div>
      </div>

      <div class="short:mb-6 mb-8 sm:mb-10 lg:mb-12">
        <h1
          class="grid-interaction-blocked pointer-events-auto text-4xl leading-tight font-thin tracking-tight text-white sm:text-5xl sm:leading-none md:text-6xl lg:text-7xl xl:text-8xl short:text-6xl"
          style="font-size: clamp(2.25rem, 6vw, 6rem)"
        >
          <span class="inline-block overflow-hidden align-bottom">
            <span class="reveal-up-title inline-block font-medium">{HERO_TITLE_LEFT}</span>
          </span>
          <span class="inline-block overflow-hidden align-bottom">
            <span class="reveal-up-title mx-2 inline-block text-white sm:mx-3" aria-hidden="true">/</span>
          </span>
          <span class="inline-block overflow-hidden align-bottom">
            <span
              class="reveal-up-title inline-block pr-[0.15em] text-transparent italic [-webkit-text-stroke:1px_white] [text-stroke:1px_white]"
            >
              {HERO_TITLE_RIGHT}
            </span>
          </span>
        </h1>
      </div>

      <div class="flex flex-col items-center gap-6 sm:gap-8 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-xl overflow-hidden lg:max-w-2xl">
          <p
            class="grid-interaction-blocked pointer-events-auto reveal-up text-sm leading-relaxed font-light tracking-wide text-muted-foreground sm:text-base lg:text-lg short:text-base"
          >
            {HERO_DESCRIPTION}
          </p>
        </div>

        <div class="shrink-0 overflow-hidden">
          <div class="reveal-up">
            <a
              href="/contact"
              data-hero-cta
              aria-label={HERO_CTA}
              class="pointer-events-auto inline-block"
            >
              <span
                class="relative inline-block shrink-0 cursor-pointer border-b border-muted-foreground/50 transition-[color,background-color,border-color,opacity,transform,box-shadow,filter] duration-300 hover:scale-[1.02] hover:border-primary active:scale-[0.98]"
              >
                <span
                  data-scramble
                  data-original={HERO_CTA}
                  class="text-sm font-light tracking-[0.2em] text-white uppercase sm:text-base"
                >
                  {HERO_CTA}
                </span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
